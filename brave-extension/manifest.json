{
  "manifest_version": 3,
  "name": "ClipBridge Auto Attach",
  "short_name": "ClipBridge",
  "description": "Opt-in local clip attachment to an open ChatGPT tab in normal Brave. Never sends messages.",
  "version": "0.1.0",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["http://127.0.0.1:38419/*"],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "ClipBridge Auto Attach",
    "default_popup": "popup.html"
  }
}
