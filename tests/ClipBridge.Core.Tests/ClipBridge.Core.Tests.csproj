<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Playwright" Version="1.64.1" />
    <EmbeddedResource Include="../../brave-extension/composer.js" LogicalName="ClipBridge.Composer.js" />
    <EmbeddedResource Include="../../src/ClipBridge/Core/AutomaticUploadPage.js" LogicalName="ClipBridge.AutomaticUploadPage.js" />
    <Compile Include="../../src/ClipBridge/Core/*.cs" Link="Core/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
