<Window x:Class="ClipBridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipBridge - Windows Video Splitter"
        Width="920" Height="700" MinWidth="760" MinHeight="620"
        Background="{StaticResource WindowBackground}"
        FontFamily="Segoe UI" Foreground="White"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock FontSize="30" FontWeight="Bold" Text="ClipBridge" />
            <TextBlock Foreground="#94A3B8" FontSize="13" Margin="0,5,0,0"
                       Text="Split large videos into smaller, numbered files — entirely on your Windows PC." />
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="#475569" BorderThickness="2" CornerRadius="12"
                Background="{StaticResource PanelBackground}" Padding="22" Margin="0,0,0,18">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="Drop videos anywhere in this window" FontSize="17" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="or choose one or more MP4, MOV, MKV, or AVI files"
                           Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,7,0,12" />
                <Button x:Name="AddVideosButton" Content="Select videos" HorizontalAlignment="Center"
                        Click="AddVideosButton_Click" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,10">
                <TextBlock Text="Video queue" FontSize="17" FontWeight="SemiBold" DockPanel.Dock="Left" />
                <Button x:Name="ClearButton" Content="Clear queue" DockPanel.Dock="Right"
                        HorizontalAlignment="Right" Click="ClearButton_Click" />
            </DockPanel>
            <ListBox x:Name="VideoList" Grid.Row="1" Background="#0F172A" BorderBrush="#334155"
                     BorderThickness="1" Foreground="White" FontSize="13" Padding="8" />
        </Grid>

        <Border Grid.Row="3" Background="{StaticResource PanelBackground}" CornerRadius="12"
                Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Maximum clip size (MB)" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBox x:Name="TargetSizeBox" Grid.Column="1" Text="400" VerticalContentAlignment="Center" />
                    <TextBlock Text="Mode" Grid.Column="3" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <ComboBox x:Name="ModeBox" Grid.Column="4" SelectedIndex="0" Padding="6"
                              Background="#0F172A" Foreground="#111827">
                        <ComboBoxItem Content="Fast split (no re-encoding)" />
                    </ComboBox>
                </Grid>
                <DockPanel>
                    <TextBlock Text="Output folder" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Content="Browse…" DockPanel.Dock="Right" Click="BrowseOutputButton_Click" />
                    <TextBox x:Name="OutputFolderBox" VerticalContentAlignment="Center" IsReadOnly="True"
                             Text="" ToolTip="Select where processed clips should be saved" />
                </DockPanel>
                <TextBlock Text="Fast mode preserves encoded video/audio. Some clips may exceed the limit if the input has long keyframe intervals; oversized results are never marked successful."
                           TextWrapping="Wrap" FontSize="11" Foreground="#94A3B8" Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="4">
            <ProgressBar x:Name="Progress" Height="8" IsIndeterminate="False" Minimum="0" Maximum="100" />
            <TextBlock x:Name="StatusLabel" Foreground="#94A3B8" Text="Ready" FontSize="12"
                       Margin="0,8,0,12" TextWrapping="Wrap" />
            <WrapPanel>
                <Button x:Name="StartButton" Content="Split videos" Background="#0284C7"
                        Click="StartButton_Click" />
                <Button x:Name="CancelButton" Content="Cancel" IsEnabled="False" Click="CancelButton_Click" />
                <Button Content="Open output folder" Click="OpenOutputButton_Click" />
                <Button Content="Open ChatGPT" Click="OpenChatGptButton_Click" />
            </WrapPanel>
        </StackPanel>
    </Grid>
</Window>
