<Window x:Class="ClipBridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipBridge - Windows Video Splitter"
        Width="1060" Height="860" MinWidth="850" MinHeight="750"
        Background="{StaticResource WindowBackground}"
        FontFamily="Segoe UI" Foreground="White"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <DockPanel>
                <TextBlock x:Name="VersionLabel" Foreground="#7DD3FC"
                           FontSize="12" DockPanel.Dock="Right" VerticalAlignment="Center" />
                <TextBlock FontSize="30" FontWeight="Bold" Text="ClipBridge" />
            </DockPanel>
            <TextBlock Foreground="#94A3B8" FontSize="13" Margin="0,5,0,0"
                       Text="Split large videos into smaller, numbered files — entirely on your Windows PC." />
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="#475569" BorderThickness="2" CornerRadius="12"
                Background="{StaticResource PanelBackground}" Padding="22" Margin="0,0,0,18">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="Drop videos or folders anywhere in this window" FontSize="17" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="or choose one or more MP4, MOV, MKV, or AVI files"
                           Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,7,0,12" />
                <WrapPanel HorizontalAlignment="Center">
                    <Button x:Name="AddVideosButton" Content="Select videos" Click="AddVideosButton_Click" />
                    <Button x:Name="AddFolderButton" Content="Add video folder" Click="AddFolderButton_Click" />
                </WrapPanel>
                <CheckBox x:Name="IncludeSubfoldersBox" Content="Include subfolders" Foreground="White"
                          HorizontalAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,10">
                <TextBlock Text="Video queue" FontSize="17" FontWeight="SemiBold" DockPanel.Dock="Left" />
                <Button x:Name="ClearButton" Content="Clear queue" DockPanel.Dock="Right"
                        HorizontalAlignment="Right" Click="ClearButton_Click" />
            </DockPanel>
            <ListBox x:Name="VideoList" Grid.Row="1" MinHeight="100" MaxHeight="220" Background="#0F172A" BorderBrush="#334155"
                     BorderThickness="1" Foreground="White" FontSize="13" Padding="8" />
        </Grid>

        <Border Grid.Row="3" Background="{StaticResource PanelBackground}" CornerRadius="12"
                Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Maximum clip size (MB)" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBox x:Name="TargetSizeBox" Grid.Column="1" Text="100" VerticalContentAlignment="Center" />
                    <TextBlock Text="Mode" Grid.Column="3" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <ComboBox x:Name="ModeBox" Grid.Column="4" SelectedIndex="3" Padding="6"
                              Background="#0F172A" Foreground="#111827">
                        <ComboBoxItem Content="Fast split (no re-encoding)" />
                        <ComboBoxItem Content="Compress — higher quality (CRF 24)" />
                        <ComboBoxItem Content="Compress — balanced (CRF 28)" />
                        <ComboBoxItem Content="Compress — smaller file (CRF 32)" />
                    </ComboBox>
                </Grid>
                <DockPanel>
                    <TextBlock Text="Output folder" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Content="Browse…" DockPanel.Dock="Right" Click="BrowseOutputButton_Click" />
                    <TextBox x:Name="OutputFolderBox" VerticalContentAlignment="Center" IsReadOnly="True"
                             Text="" ToolTip="Select where processed clips should be saved" />
                </DockPanel>
                <TextBlock Text="Fast mode copies streams without quality loss. Compression converts to H.264/AAC and takes longer. Any oversized result is reported, not marked successful."
                           TextWrapping="Wrap" FontSize="11" Foreground="#94A3B8" Margin="0,10,0,0" />
                <Separator Margin="0,14,0,10" Background="#334155" />
                <CheckBox x:Name="CloudflareEnabledBox" Content="Enable optional Cloudflare live monitoring"
                          Foreground="#F8FAFC" FontWeight="SemiBold" Margin="0,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" /><ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Your Worker HTTPS URL" FontSize="11" Foreground="#94A3B8" />
                        <TextBox x:Name="CloudflareUrlBox" Text=""
                                 VerticalContentAlignment="Center" ToolTip="Cloudflare dashboard Worker address" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="INGEST_TOKEN (never stored)" FontSize="11" Foreground="#94A3B8" />
                        <PasswordBox x:Name="CloudflareTokenBox" Background="#0F172A" Foreground="White"
                                     BorderBrush="#475569" Padding="8" />
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="CloudflareStatusLabel" Text="Cloudflare: disabled; no video data sent"
                           Foreground="#94A3B8" FontSize="11" Margin="0,7,0,0" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="4">
            <DockPanel Margin="0,0,0,6">
                <TextBlock Text="Processing progress" FontWeight="SemiBold" FontSize="12" />
                <TextBlock x:Name="ProgressPercentLabel" Text="0%" DockPanel.Dock="Right"
                           FontWeight="SemiBold" HorizontalAlignment="Right" />
            </DockPanel>
            <ProgressBar x:Name="Progress" Height="8" IsIndeterminate="False" Minimum="0" Maximum="100" />
            <TextBlock x:Name="ProgressInfoLabel" Text="No processing activity"
                       Foreground="#7DD3FC" FontSize="11" Margin="0,5,0,0" />
            <TextBlock x:Name="StatusLabel" Foreground="#94A3B8" Text="Ready" FontSize="12"
                       Margin="0,8,0,12" TextWrapping="Wrap" />
            <WrapPanel>
                <Button x:Name="AutomaticUploadButton" Content="Automatic uploads (Playwright)" Background="#0369A1"
                        Click="AutomaticUploadButton_Click" />
                <Button x:Name="StartButton" Content="Split videos" Background="#0284C7"
                        Click="StartButton_Click" />
                <Button x:Name="CancelButton" Content="Cancel" IsEnabled="False" Click="CancelButton_Click" />
                <Button Content="Open output folder" Click="OpenOutputButton_Click" />
                <Button x:Name="BRollButton" Content="B-roll cutter &amp; library"
                        Click="BRollButton_Click" />
                <Button x:Name="ChatGptLoginButton" Content="Open ChatGPT in Brave"
                        Click="ChatGptLoginButton_Click" />
                <Button x:Name="AddPreparedButton" Content="Add prepared clips" Click="AddPreparedButton_Click" />
                <Button x:Name="AttachButton" Content="Show next 3 clips (manual)" IsEnabled="False"
                        Click="AttachButton_Click" />
            </WrapPanel>
            <TextBlock Text="For reusable garden footage, open B-roll cutter &amp; library. Mark In / Out, tag planting, harvesting, pruning and more, then filter saved clips with checkboxes."
                       Foreground="#A4F4DC" FontSize="11" TextWrapping="Wrap" Margin="0,9,0,0" />
            <TextBlock Text="For automatic uploads and Send, open Automatic uploads (Playwright), choose your prepared clip folder, sign in once and start. The saved queue runs through every ready batch. The extension below remains optional."
                       Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" Margin="0,9,0,0" />
            <Border Margin="0,12,0,0" Padding="12" BorderThickness="1" BorderBrush="#36624E"
                    CornerRadius="10" Background="#14271E">
                <StackPanel>
                    <TextBlock Text="Brave batch uploads (optional)" FontWeight="Bold" Foreground="#A4F4DC" />
                    <CheckBox x:Name="AutoAttachEnabledBox"
                              Content="Allow ClipBridge to offer prepared clips to the Brave extension"
                              Checked="AutoAttachEnabledBox_Checked" Unchecked="AutoAttachEnabledBox_Unchecked"
                              Foreground="White" Margin="0,6,0,8" />
                    <WrapPanel>
                        <Button x:Name="CopyBridgeKeyButton" Content="Copy extension pairing key"
                                Click="CopyBridgeKeyButton_Click" IsEnabled="False" />
                        <Button x:Name="NextBridgeBatchButton" Content="Allow next 3 clips"
                                Click="NextBridgeBatchButton_Click" IsEnabled="False" />
                        <Button Content="Retry unattempted transfers" Click="RetryBridgeButton_Click" />
                    </WrapPanel>
                    <TextBlock Text="Set batch size and optional auto-send in the extension. New jobs default to 100 MB clips and smaller-file compression. The website may enforce lower limits."
                               FontSize="11" Foreground="#C4D7CD" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <TextBlock x:Name="BraveBridgeStatusLabel"
                               Text="Disabled. Enable the bridge and install the ClipBridge Brave extension."
                               FontSize="11" Foreground="#C4D7CD" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <TextBlock x:Name="BraveBridgeQueueLabel" FontSize="11" Foreground="#C4D7CD" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
    </ScrollViewer>
</Window>
