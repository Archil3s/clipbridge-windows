<Window x:Class="ClipBridge.BRollWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipBridge — B-roll library" Width="980" Height="950"
        MinWidth="780" MinHeight="820" Background="{StaticResource WindowBackground}"
        Foreground="White" FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="B-roll library" FontSize="27" FontWeight="Bold"/>
                <TextBlock Text="Trim reusable shots from long videos. Originals remain untouched."
                           Foreground="#A7B8C4" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
            <Button x:Name="SelectSourceButton" Content="Choose source video" DockPanel.Dock="Right"
                    VerticalAlignment="Bottom" Click="SelectSourceButton_Click"/>
        </DockPanel>

        <Border Grid.Row="1" BorderBrush="#405568" BorderThickness="1"
                Background="#0A1016" CornerRadius="12" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="SourceNameLabel" Text="Choose a source video to begin"
                           Foreground="#B8CCD0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           Margin="0,0,0,10"/>
                <MediaElement x:Name="Player" Grid.Row="1" LoadedBehavior="Manual"
                              UnloadedBehavior="Manual" Stretch="Uniform" ScrubbingEnabled="True"
                              MediaOpened="Player_MediaOpened" MediaEnded="Player_MediaEnded"
                              MediaFailed="Player_MediaFailed"/>
                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <Slider x:Name="SeekSlider" Minimum="0" Maximum="1"
                            TickFrequency="1" IsSnapToTickEnabled="False"
                            ValueChanged="SeekSlider_ValueChanged"
                            ToolTip="Move through the source video"/>
                    <DockPanel Margin="0,9,0,0">
                        <TextBlock x:Name="PlaybackTimeLabel" Text="00:00:00 / 00:00:00"
                                   Foreground="#A7B8C4" VerticalAlignment="Center"
                                   DockPanel.Dock="Right"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="PlayPauseButton" Content="Play" Width="74"
                                    Click="PlayPauseButton_Click"/>
                            <Button Content="Back 5s" Click="BackFiveButton_Click"/>
                            <Button Content="Forward 5s" Click="ForwardFiveButton_Click"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock x:Name="PreviewNotice" Text="Windows preview supports installed media codecs. If a video cannot preview, you can still enter start/end times manually."
                               Foreground="#98ABB6" FontSize="11" TextWrapping="Wrap" Margin="0,9,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource PanelBackground}" CornerRadius="12"
                Padding="15" Margin="0,14,0,12">
            <StackPanel>
                <TextBlock Text="Choose your shot" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Start time (mm:ss or hh:mm:ss)" Foreground="#A7B8C4" FontSize="11"/>
                        <DockPanel Margin="0,5,0,0">
                            <Button Content="Mark In" DockPanel.Dock="Right" Click="MarkInButton_Click"/>
                            <TextBox x:Name="StartTimeBox" Text="00:00" VerticalContentAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="End time (mm:ss or hh:mm:ss)" Foreground="#A7B8C4" FontSize="11"/>
                        <DockPanel Margin="0,5,0,0">
                            <Button Content="Mark Out" DockPanel.Dock="Right" Click="MarkOutButton_Click"/>
                            <TextBox x:Name="EndTimeBox" Text="00:00" VerticalContentAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Clip name" Foreground="#A7B8C4" FontSize="11"/>
                        <TextBox x:Name="ClipNameBox" Text="B-Roll" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Category folder (editable)" Foreground="#A7B8C4" FontSize="11"/>
                        <ComboBox x:Name="CategoryBox" IsEditable="True" Text="Garden"
                                  Margin="0,5,0,0" Foreground="#111827" Background="White">
                            <ComboBoxItem Content="Garden"/>
                            <ComboBoxItem Content="Food"/>
                            <ComboBoxItem Content="Nature"/>
                            <ComboBoxItem Content="Tools"/>
                            <ComboBoxItem Content="Travel"/>
                            <ComboBoxItem Content="Unsorted"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
                <TextBlock Text="Garden topics — tick all that apply to this clip"
                           Foreground="#BCE9D7" FontWeight="SemiBold" FontSize="12"
                           Margin="0,14,0,7"/>
                <WrapPanel>
                    <CheckBox x:Name="TagPlanting" Tag="Planting" Content="Planting" Margin="0,0,14,7"/>
                    <CheckBox x:Name="TagHarvesting" Tag="Harvesting" Content="Harvesting" Margin="0,0,14,7"/>
                    <CheckBox x:Name="TagWatering" Tag="Watering" Content="Watering" Margin="0,0,14,7"/>
                    <CheckBox x:Name="TagSoil" Tag="Compost &amp; Soil" Content="Compost &amp; Soil" Margin="0,0,14,7"/>
                    <CheckBox x:Name="TagPruning" Tag="Pruning" Content="Pruning" Margin="0,0,14,7"/>
                    <CheckBox x:Name="TagSeedlings" Tag="Seedlings" Content="Seedlings" Margin="0,0,14,7"/>
                    <CheckBox x:Name="TagTools" Tag="Tools" Content="Tools" Margin="0,0,14,7"/>
                    <CheckBox x:Name="TagWildlife" Tag="Wildlife" Content="Wildlife" Margin="0,0,14,7"/>
                    <CheckBox x:Name="TagWeeding" Tag="Weeding" Content="Weeding" Margin="0,0,14,7"/>
                    <CheckBox x:Name="TagOverview" Tag="Garden Overview" Content="Garden Overview" Margin="0,0,14,7"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Background="{StaticResource PanelBackground}" CornerRadius="12"
                Padding="15" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="B-roll folder" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,7"/>
                <DockPanel>
                    <Button Content="Change folder…" DockPanel.Dock="Right" Click="ChooseLibraryButton_Click"/>
                    <TextBox x:Name="LibraryFolderBox" IsReadOnly="True" VerticalContentAlignment="Center"/>
                </DockPanel>
                <DockPanel Margin="0,10,0,0">
                    <Button Content="Open B-roll folder" DockPanel.Dock="Right"
                            Click="OpenLibraryButton_Click"/>
                    <Button x:Name="ExportButton" Content="Save clip to library"
                            Background="#0284C7" Click="ExportButton_Click"/>
                    <Button x:Name="CancelExportButton" Content="Cancel export"
                            IsEnabled="False" Click="CancelExportButton_Click"/>
                </DockPanel>
                <ProgressBar x:Name="ExportProgress" Height="7" Minimum="0" Maximum="100"
                             Margin="0,10,0,0"/>
                <TextBlock x:Name="ExportStatusLabel" Text="Choose a video and mark a start and end."
                           Foreground="#A7B8C4" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Padding="12" BorderBrush="#405568"
                BorderThickness="1" CornerRadius="10" Background="#131F29">
            <StackPanel>
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="Find saved gardening B-roll" FontSize="14"
                               FontWeight="SemiBold" DockPanel.Dock="Left"/>
                    <Button Content="Clear filters" DockPanel.Dock="Right" Click="ClearFiltersButton_Click"/>
                    <Button Content="Refresh library" DockPanel.Dock="Right" Click="RefreshLibraryButton_Click"/>
                </DockPanel>
                <WrapPanel>
                    <CheckBox x:Name="FilterPlanting" Tag="Planting" Content="Planting" Margin="0,0,12,7" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                    <CheckBox x:Name="FilterHarvesting" Tag="Harvesting" Content="Harvesting" Margin="0,0,12,7" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                    <CheckBox x:Name="FilterWatering" Tag="Watering" Content="Watering" Margin="0,0,12,7" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                    <CheckBox x:Name="FilterSoil" Tag="Compost &amp; Soil" Content="Compost &amp; Soil" Margin="0,0,12,7" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                    <CheckBox x:Name="FilterPruning" Tag="Pruning" Content="Pruning" Margin="0,0,12,7" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                    <CheckBox x:Name="FilterSeedlings" Tag="Seedlings" Content="Seedlings" Margin="0,0,12,7" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                    <CheckBox x:Name="FilterTools" Tag="Tools" Content="Tools" Margin="0,0,12,7" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                    <CheckBox x:Name="FilterWildlife" Tag="Wildlife" Content="Wildlife" Margin="0,0,12,7" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                    <CheckBox x:Name="FilterWeeding" Tag="Weeding" Content="Weeding" Margin="0,0,12,7" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                    <CheckBox x:Name="FilterOverview" Tag="Garden Overview" Content="Garden Overview" Margin="0,0,12,7" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                </WrapPanel>
                <TextBlock Text="Select multiple topics to show clips matching any checked topic. No selection shows everything."
                           FontSize="11" Foreground="#9DB3BC" TextWrapping="Wrap"/>
                <TextBlock x:Name="LibraryCountLabel" Text="0 saved clips" FontSize="11"
                           Foreground="#A4F4DC" Margin="0,5,0,4"/>
                <ListBox x:Name="SavedClipsList" Height="76" Background="#0F172A"
                         Foreground="White" BorderBrush="#334155" Padding="5"
                         DisplayMemberPath="DisplayText"
                         MouseDoubleClick="SavedClipsList_MouseDoubleClick"/>
                <Button Content="Apply checked topic tags to selected saved clip"
                        Margin="0,8,0,0" HorizontalAlignment="Left"
                        Click="ApplyTagsToSelectedButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
